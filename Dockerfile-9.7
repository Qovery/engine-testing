FROM public.ecr.aws/docker/library/busybox:1.37.0-musl AS busybox

FROM public.ecr.aws/r3m4q3r9/pub-mirror-mysql:9.7-oracle
# Oracle Linux base: installing a package means downloading the dnf metadata, which can take
# close to 30 minutes from CI. A static busybox serves the :1234 health endpoint instead.
COPY --from=busybox /bin/busybox /usr/local/bin/busybox
USER 999
WORKDIR /
COPY run.sh /
# Drop the mysql server entrypoint so CMD runs run.sh directly instead of trying to boot mysqld.
ENTRYPOINT []
CMD ["/run.sh"]
